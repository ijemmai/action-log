{
  "name": "@devvit/protos",
  "version": "0.15.0",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://developers.reddit.com/"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./community.js": {
      "types": "./community.d.ts",
      "import": "./community.js"
    },
    "./package.json": "./package.json",
    "./*": "./*"
  },
  "main": "./dist/index.js",
  "files": [
    "schema/",
    "**"
  ],
  "scripts": {
    "build": "tsc",
    "build:docs": "PROTO_TYPES_ONLY=1 yarn build:protos",
    "build:protos": "./scripts/gen-proto.sh",
    "clean": "rm -rf .turbo coverage dist docs.json docs",
    "clobber": "yarn clean && rm -rf node_modules",
    "format": "./scripts/format.mts",
    "lint": "./scripts/lint-proto.sh --ignore-in-ci && yarn lint:breaking && yarn lint:reddit-api-json && redlint .",
    "lint:breaking": "./scripts/lint-proto-breaking.sh --ignore-in-ci",
    "lint:fix": "redlint . --fix",
    "lint:reddit-api-json": "echo 'todo run esbuild on validate and then execute it; ts-node and tsc fail at dealing with ESM'",
    "prepublish-cleanup": "node ./scripts/prepublish-cleanup.ts",
    "prepublishOnly": "cp -a ./schema ./dist && yarn prepublish-cleanup && publish-package-json",
    "redditapi:validate": "node ./scripts/redditapi/validate-protos.ts",
    "test": "yarn test:unit && yarn test:types",
    "test:types": "tsc --noEmit && tsc --noEmit --project scripts",
    "test:unit": "vitest run",
    "test:unit-with-coverage": "vitest run --coverage"
  },
  "types": "./dist/index.d.ts",
  "dependencies": {
    "protobufjs": "7.6.5",
    "rxjs": "7.8.1"
  },
  "peerDependencies": {
    "twirp-ts": "^2.5.0"
  },
  "peerDependenciesMeta": {
    "twirp-ts": {
      "optional": true
    }
  },
  "devDependencies": {
    "@devvit/repo-tools": "0.15.0",
    "@devvit/tsconfig": "0.15.0",
    "@protobuf-ts/plugin": "2.9.3",
    "eslint": "9.11.1",
    "glob": "10.5.0",
    "ts-proto": "1.172.0",
    "twirp-ts": "2.5.0",
    "typescript": "5.8.3",
    "vitest": "4.1.0"
  },
  "typesVersions": {
    "*": {
      ".": [
        "./index.d.ts"
      ],
      "community.js": [
        "./community.d.ts"
      ]
    }
  },
  "gitHead": "69bb02508b103156b270269f71c8afbb6b5b5855"
}
