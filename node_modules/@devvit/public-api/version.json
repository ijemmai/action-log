{
    "name": "@devvit/public-api",
    "version": "0.15.0-dev",
    "license": "BSD-3-Clause",
    "repository": {
        "type": "git",
        "url": "https://developers.reddit.com/"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json",
        "./*": "./dist/*"
    },
    "main": "./dist/index.js",
    "files": [
        "dist/**"
    ],
    "scripts": {
        "build": "tsc && cp -af devvit.tsconfig.json dist/",
        "clean": "rm -rf .turbo coverage dist",
        "clobber": "yarn clean && rm -rf node_modules",
        "lint": "redlint .",
        "lint:fix": "yarn lint --fix",
        "prepublishOnly": "publish-package-json",
        "test": "yarn test:unit && yarn test:types",
        "test:types": "tsc --noEmit",
        "test:unit": "vitest run",
        "test:unit-with-coverage": "vitest run --coverage"
    },
    "types": "./dist/index.d.ts",
    "dependencies": {
        "@devvit/cache": "0.15.0-dev",
        "@devvit/media": "0.15.0-dev",
        "@devvit/protos": "0.15.0-dev",
        "@devvit/reddit": "0.15.0-dev",
        "@devvit/redis": "0.15.0-dev",
        "@devvit/scheduler": "0.15.0-dev",
        "@devvit/server": "0.15.0-dev",
        "@devvit/settings": "0.15.0-dev",
        "@devvit/shared": "0.15.0-dev",
        "@devvit/shared-types": "0.15.0-dev"
    },
    "devDependencies": {
        "@devvit/repo-tools": "0.15.0-dev",
        "@devvit/tsconfig": "0.15.0-dev",
        "@types/node": "24.13.3",
        "eslint": "9.11.1",
        "typescript": "5.8.3",
        "vitest": "4.1.0"
    },
    "publishConfig": {
        "directory": "dist"
    },
    "source": "./src/index.ts"
}
